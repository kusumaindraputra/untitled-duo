[resource]
default_font = ExtResource("font_pixel")
default_font_size = 16
BodyLabel/base_type = &"Label"
BodyLabel/fonts/font = ExtResource("font_body")
RichTextLabel/fonts/normal_font = ExtResource("font_body")
RichTextLabel/fonts/bold_font = ExtResource("font_body_bold")
Button/colors/font_color = Color(0.91, 0.87, 0.8, 1)
Button/colors/font_hover_color = Color(1, 0.96, 0.88, 1)
Button/colors/font_pressed_color = Color(0.82, 0.74, 0.62, 1)
Button/colors/font_focus_color = Color(1, 0.96, 0.88, 1)
Button/colors/font_disabled_color = Color(0.5, 0.47, 0.44, 1)
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_focus")
Label/colors/font_shadow_color = Color(0, 0, 0, 0.55)
Label/constants/shadow_offset_x = 1
Label/constants/shadow_offset_y = 1
Panel/styles/panel = SubResource("panel")
PanelContainer/styles/panel = SubResource("panel")
ProgressBar/colors/font_color = Color(0.97, 0.95, 0.92, 1)
ProgressBar/colors/font_outline_color = Color(0.05, 0.04, 0.05, 1)
ProgressBar/constants/outline_size = 4
ProgressBar/styles/background = SubResource("bar_bg")
ProgressBar/styles/fill = SubResource("bar_fill")
TooltipPanel/styles/panel = SubResource("tooltip")
HSlider/styles/slider = SubResource("slider")
HSlider/styles/grabber_area = SubResource("slider_fill")
HSlider/styles/grabber_area_highlight = SubResource("slider_fill")
