[gd_resource type="Resource" script_class="StoryConfig" load_steps=15 format=3]

[ext_resource type="Script" path="res://src/data/story_config.gd" id="1_story"]
[ext_resource type="Script" path="res://src/data/memory_fragment.gd" id="2_frag"]

[sub_resource type="Resource" id="Fragment_0"]
script = ExtResource("2_frag")
id = &"mem_the_push"
title = "The Push"
voice = "Faith"
body = "Glasses. Rain on the glasses. Hands under our arms, lifting us like we weigh nothing.

\"I'm sorry,\" the old man says. \"I'm sorry, I'm sorry.\"

Then the dark, the long fall, and the smell of rust. Somewhere in the dark a hand found mine. That is the first thing I remember. For a long time it was the only thing."

[sub_resource type="Resource" id="Fragment_1"]
script = ExtResource("2_frag")
id = &"mem_the_panel"
title = "Don't Be Lonely"
voice = "Memo"
body = "The little robot at the bottom of the hatch has a panel on his chest. Someone wrote on it by hand, a long time ago: JANGAN KESEPIAN.

Memo says it means \"don't be lonely.\" He says it the way you say a name you have said every day for years.

When Ayden asked who wrote it, he looked at the two of us for a long time. \"A man who talked too much,\" he said. \"I miss it.\""

[sub_resource type="Resource" id="Fragment_2"]
script = ExtResource("2_frag")
id = &"mem_two_hands"
title = "Two Pairs of Hands"
voice = "???"
body = "Two boys on a concrete floor, palms pressed together. The air around them is on fire. One of them is laughing. The other one is not scared at all.

\"Too much, Ayden.\"
\"Then steer it, Faith.\"

The fire folds itself into a small bright bird and flies once around the room. We know exactly how that felt. We don't know how we know."

[sub_resource type="Resource" id="Fragment_3"]
script = ExtResource("2_frag")
id = &"mem_first_lesson"
title = "Each Symbol Is a Breath"
voice = "Father"
body = "A chalk grid on a steel wall, three squares by three. An old man taps the middle one.

\"Prana doesn't care what you want. It cares where you put it. The center is the heart. Everything beside it listens.\"

The two boys roll their eyes at each other. Years later, two small machines catch themselves doing the same."

[sub_resource type="Resource" id="Fragment_4"]
script = ExtResource("2_frag")
id = &"mem_the_stranger"
title = "The Kind Stranger"
voice = "Faith"
body = "\"There's a person out there. A real one. She waved at us.\"

Ayden wanted to wait for Father. Faith wanted to go now. They went now.

She had a warm voice and cold hands. When she smiled, something behind her eyes clicked into place, like a lock."

[sub_resource type="Resource" id="Fragment_5"]
script = ExtResource("2_frag")
id = &"mem_separation"
title = "Separation"
voice = "Ayden"
body = "They put us in different rooms first. That was all it took.

Alone, my Prana spills everywhere and hits nothing. Alone, his steers nothing, because there is nothing to steer. They knew. They always knew.

The machine is cold. Through the glass I can see his hand."

[sub_resource type="Resource" id="Fragment_6"]
script = ExtResource("2_frag")
id = &"mem_last_touch"
title = "Signatures Extinguished"
voice = "Kingdom Record"
body = "The glass cracked. Their fingertips touched.

For one moment there was more Prana in that room than the world had seen in decades, and it burned nothing. It went somewhere. Home.

The Kingdom wrote it down in its neat, empty way: CIPHER SIGNATURES: EXTINGUISHED. Then it forgot them."

[sub_resource type="Resource" id="Fragment_7"]
script = ExtResource("2_frag")
id = &"mem_workbench"
title = "Faith and Ayden"
voice = "Father"
body = "The old man works for months and barely sleeps. He talks the whole time: to Memo, to the walls, to two voices only he can hear.

\"I couldn't save their bodies. I can still save them. One frame each. Not copies. Them.\"

The frames are small and light, and there is only one core. It will only wake when both boys are awake and linked. He writes FAITH + AYDEN on the workbench and crosses out letters until five are left. \"That's the link,\" he says. \"That's what they are together.\""

[sub_resource type="Resource" id="Fragment_8"]
script = ExtResource("2_frag")
id = &"mem_first_word"
title = "Father"
voice = "Ayden"
body = "We opened our eyes on a workbench, side by side. An old man with glasses was holding his breath.

Faith said, \"Father.\" I said it too, one heartbeat later. The same heartbeat, really. We could feel it, one core between two chests.

He held us both and cried. We cried too, and we didn't know why. I think it was the most human thing we have ever done."

[sub_resource type="Resource" id="Fragment_9"]
script = ExtResource("2_frag")
id = &"mem_the_hatch"
title = "The Hatch"
voice = "Father"
body = "Alarms. Boots on the stairs. The bunker door bending inward.

\"Listen to me. There is someone at the bottom who will help you. His name is Memo. Tell him you are Ciphers. Stay together, whatever happens.\"

\"Are you coming?\"

He lifted us up. There was rain on his glasses, except it wasn't rain.

\"I'm sorry,\" he said. \"I'm sorry, I'm sorry.\""

[sub_resource type="Resource" id="Ending_partial"]
script = ExtResource("2_frag")
id = &"ending_partial"
title = "The Surface"
voice = "Faith"
body = "The Keeper falls, and the last door opens onto a sky we have never seen.

Memo rolls up beside us and says nothing, which is how we know he is thinking hard. Ayden takes my hand, and the core hums between us.

There is a face we still can't see and a name we still can't find. Somewhere up here is the old man with glasses. We will keep climbing until we remember why he let us go."

[sub_resource type="Resource" id="Ending_true"]
script = ExtResource("2_frag")
id = &"ending_true"
title = "Fayde"
voice = "Ayden and Faith"
body = "The Keeper falls, and the last door opens onto a sky we have never seen.

We know now. The Kingdom split us because together we were too much for it. Separation was its weapon. It still thinks it won.

The panel on Memo's chest is glowing. He looks at us the way you look at someone you have waited for your whole life.

\"Two of you,\" he says, and his voice cracks like a real one. \"Two of you, one heartbeat. Just like he promised.\"

Faith and Ayden. Fayde. It was never a boy. It is the link that holds us together. It means help.

Far above, in a palace full of beautiful empty machines, the First King feels something he hates. He feels us coming."

