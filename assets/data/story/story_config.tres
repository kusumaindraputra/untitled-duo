script = ExtResource("1_story")
fragments = Array[ExtResource("2_frag")]([SubResource("Fragment_0"), SubResource("Fragment_1"), SubResource("Fragment_2"), SubResource("Fragment_3"), SubResource("Fragment_4"), SubResource("Fragment_5"), SubResource("Fragment_6"), SubResource("Fragment_7"), SubResource("Fragment_8"), SubResource("Fragment_9")])
ending_partial = SubResource("Ending_partial")
ending_true = SubResource("Ending_true")
